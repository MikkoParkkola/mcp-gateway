 /** The top of the y scale: the largest value rounded up to 1, 2 or 5 times a power of ten; 1 for a quiet chart. */
 function scaleTop(v) {
-  if (!(v > 0)) return 1;
+  if (!(v > 0)) return 10;
   const p = 10 ** Math.floor(Math.log10(v));
   return [1, 2, 5, 10].map((m) => m * p).find((c) => c >= v * (1 - 1e-9));
 }
