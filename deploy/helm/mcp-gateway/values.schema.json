{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/MikkoParkkola/mcp-gateway/deploy/helm/mcp-gateway/values.schema.json",
  "$comment": "schemaVersion: 1 \u2014 evolve additively within a chart minor; a breaking values change requires a chart major + a note in the release.",
  "title": "mcp-gateway Helm values",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "replicaCount",
    "image",
    "service"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "description": "Must be 1001, the image's gateway UID/GID; any other value fails the render.",
          "const": 1001
        },
        "runAsGroup": {
          "type": "integer",
          "description": "Must be 1001, the image's gateway UID/GID; any other value fails the render.",
          "const": 1001
        },
        "fsGroup": {
          "type": "integer",
          "description": "Must be 1001, the image's gateway GID; any other value fails the render. The gateway reads its root-owned config through this group (CONFIG.2).",
          "const": 1001
        }
      }
    },
    "stateVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": {
          "type": "string",
          "description": "sizeLimit of the state emptyDir (HOME); past it the kubelet evicts the pod."
        }
      },
      "required": [
        "sizeLimit"
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string",
          "description": "PersistentVolumeClaim for the audit log. Empty uses an emptyDir, which dies with the pod."
        },
        "sizeLimit": {
          "type": "string",
          "description": "sizeLimit of the audit emptyDir."
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSegmentBytes": {
              "type": "integer",
              "minimum": 1048576,
              "maximum": 134217728
            },
            "retainSegments": {
              "type": "integer",
              "minimum": 1
            },
            "onDiskFull": {
              "type": "string",
              "enum": [
                "expire_oldest",
                "refuse"
              ]
            },
            "maxSegmentAgeSecs": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "configVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultMode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511,
          "description": "Mode of the projected config file, in decimal: 288 is octal 0440. No world bit, or the gateway refuses the file."
        }
      }
    },
    "config": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "automountToken": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "json",
            "text"
          ]
        },
        "level": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ]
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "/metrics answers only server.metrics_token. Nothing advertises the endpoint until existingSecret names the Secret holding that token.",
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Secret holding the scrape token. Empty: no token, /metrics answers 401, and neither the prometheus.io annotations nor the ServiceMonitor render."
        },
        "secretKey": {
          "type": "string",
          "minLength": 1,
          "default": "token"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Render a prometheus-operator ServiceMonitor whose endpoint sends the token via bearerTokenSecret. Needs existingSecret and the monitoring.coreos.com CRDs."
            },
            "interval": {
              "type": "string"
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "description": "How this gateway proves who is calling it. A pod binds a network address, and the gateway refuses to serve a reachable tool surface that needs no credential, so exactly one of these modes is rendered.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "credential",
            "api_keys",
            "oidc",
            "mesh"
          ],
          "description": "credential: tools require the master bearer token from existingSecret. api_keys: each key in apiKeys is a client with its own backends; the Secret holds each key's sha256 digest. oidc: the key server exchanges OIDC ID tokens for gateway tokens under auth.oidc. mesh: a service mesh authenticates first, so server.allow_unauthenticated_network_bind is set and no credential is rendered."
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "description": "The Secret holding this mode's credentials: the bearer token (credential), each API key digest (api_keys), or the key-server admin token (oidc, only with adminTokenSecretKey)."
        },
        "secretKey": {
          "type": "string",
          "minLength": 1,
          "default": "token"
        },
        "apiKeys": {
          "type": "array",
          "description": "api_keys mode: one client per entry. The Secret key named by secretKey holds `sha256:<hex>` from `mcp-gateway hash-key`, never the key.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "secretKey",
              "backends"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "secretKey": {
                "type": "string",
                "minLength": 1
              },
              "backends": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Backends this key may call; [\"*\"] is all. Required: an empty list grants none."
              },
              "admin": {
                "type": "boolean"
              },
              "rateLimit": {
                "type": "integer",
                "minimum": 0
              },
              "allowedTools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "deniedTools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "expiresAt": {
                "type": "string",
                "minLength": 1,
                "description": "Optional RFC 3339 expiry."
              }
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "issuer",
                  "audiences"
                ],
                "properties": {
                  "issuer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "audiences": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Required: the gateway refuses a provider with no audience."
                  },
                  "allowedDomains": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "jwksUri": {
                    "type": "string",
                    "minLength": 1
                  },
                  "discoveryUrl": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "policies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "match",
                  "scopes"
                ],
                "properties": {
                  "match": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "issuer"
                    ],
                    "properties": {
                      "issuer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "domain": {
                        "type": "string",
                        "minLength": 1
                      },
                      "email": {
                        "type": "string",
                        "minLength": 1
                      },
                      "group": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "anyOf": [
                      {
                        "required": [
                          "domain"
                        ]
                      },
                      {
                        "required": [
                          "email"
                        ]
                      },
                      {
                        "required": [
                          "group"
                        ]
                      }
                    ],
                    "description": "Names an issuer and at least one of domain, email or group: a rule matching every identity of an issuer is refused at startup (UPGRADING-4.0 item 17)."
                  },
                  "scopes": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "backends": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": "Required: an empty list grants none. [\"*\"] is all."
                      },
                      "tools": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "rateLimit": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "backends"
                    ]
                  }
                }
              }
            },
            "adminTokenSecretKey": {
              "type": "string",
              "description": "Optional: the key in existingSecret holding key_server.admin_token."
            }
          }
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "credential"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "existingSecret",
              "secretKey"
            ],
            "properties": {
              "existingSecret": {
                "minLength": 1
              },
              "secretKey": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "api_keys"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "existingSecret",
              "apiKeys"
            ],
            "properties": {
              "apiKeys": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "oidc"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "oidc"
            ],
            "properties": {
              "oidc": {
                "required": [
                  "providers",
                  "policies"
                ],
                "properties": {
                  "providers": {
                    "minItems": 1
                  },
                  "policies": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cleartextHttp": {
          "type": "string",
          "enum": [
            "cluster_internal",
            "tls_terminated_upstream",
            "refuse"
          ],
          "description": "Every mode but mesh: who protects bearer tokens sent over plain HTTP on the pod's 0.0.0.0 bind (rendered as server.cleartext_http). cluster_internal: callers reach the pod only over the cluster network by its Service name; the chart then renders an ingress-only NetworkPolicy and refuses a non-ClusterIP Service or a public_url other than this release's Service name. tls_terminated_upstream: an ingress or proxy terminates TLS in front of the pod. refuse: the gateway will not start without mTLS."
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Extra container env (EnvVar[]), rendered after the chart's own. Names starting MCP_GATEWAY_ (any case) and chart-owned names are refused: MCP_GATEWAY_* variables override config."
    },
    "envFrom": {
      "type": "array",
      "description": "EnvFromSource[] for backend secrets. Each entry needs a prefix outside MCP_GATEWAY_, so no key can become a config override.",
      "items": {
        "type": "object",
        "required": [
          "prefix"
        ],
        "properties": {
          "prefix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Keep the state volume (task store, control-plane store) on a PersistentVolumeClaim. Forces one replica and the Recreate strategy.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod",
              "ReadWriteMany"
            ]
          }
        }
      }
    }
  }
}
