[Unit]
Description=MCP Gateway
Documentation=https://github.com/MikkoParkkola/mcp-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp-gateway
Group=mcp-gateway
WorkingDirectory=/etc/mcp-gateway
ExecStart=/usr/local/bin/mcp-gateway --config /etc/mcp-gateway/gateway.yaml --host 127.0.0.1 --port 39400
Restart=on-failure
RestartSec=5s
# The gateway's stop takes at most its stop timeout (30 s by default) from the
# signal; keep this at least that + 1 s (docs/DEPLOYMENT.md, Stop grace).
TimeoutStopSec=31s
# SIGTERM to the gateway only: it closes its stdio backends' stdin and stops them
# in order. The default (control-group) signals every backend at once. At the
# timeout systemd still SIGKILLs every process left in the unit.
KillMode=mixed
Environment=MCP_GATEWAY_LOG_LEVEL=info
Environment=MCP_GATEWAY_LOG_FORMAT=json
EnvironmentFile=-/etc/mcp-gateway/env
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/mcp-gateway
LimitNOFILE=65536
MemoryMax=1G

[Install]
WantedBy=multi-user.target
